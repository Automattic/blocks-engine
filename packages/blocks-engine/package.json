{
  "name": "@automattic/blocks-engine",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wp": {
      "types": "./dist/wp/index.d.ts",
      "source": "./src/wp/index.ts",
      "import": "./dist/wp/index.js",
      "require": "./dist/wp/index.cjs"
    },
    "./internals": {
      "types": "./dist/internals/index.d.ts",
      "source": "./src/internals/index.ts",
      "import": "./dist/internals/index.js",
      "require": "./dist/internals/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "@wordpress/block-serialization-default-parser": "5.47.0",
    "@wordpress/blocks": "15.15.0",
    "@wordpress/block-editor": "15.15.0",
    "@wordpress/block-library": "9.42.0",
    "@wordpress/data": "10.42.0",
    "@wordpress/hooks": "4.42.0",
    "jsdom": "29.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "8.0.0",
    "vitest": "2.0.0",
    "typescript": "5.7.3",
    "tsx": "^4.22.4"
  }
}

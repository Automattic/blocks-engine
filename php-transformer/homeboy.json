{
  "auto_cleanup": false,
  "changelog_target": "CHANGELOG.md",
  "id": "php-transformer",
  "remote_path": "",
  "release": {
    "publish": true,
    "subtree": [
      {
        "prefix": ".",
        "remote": "https://github.com/Automattic/blocks-engine-php-transformer.git",
        "branch": "trunk",
        "tag": true
      }
    ]
  },
  "version_targets": [
    {
      "file": "VERSION",
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    {
      "file": "php-transformer.php",
      "pattern": "Version: ([0-9]+\\.[0-9]+\\.[0-9]+)"
    },
    {
      "file": "php-transformer.php",
      "pattern": "BLOCKS_ENGINE_PHP_TRANSFORMER_VERSION', '([0-9]+\\.[0-9]+\\.[0-9]+)'"
    }
  ]
}

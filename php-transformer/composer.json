{
  "name": "automattic/blocks-engine-php-transformer",
  "description": "PHP primitives for transforming HTML, Markdown, and website artifacts into WordPress block outputs.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Automattic"
    }
  ],
  "keywords": [
    "blocks",
    "html",
    "markdown",
    "wordpress"
  ],
  "homepage": "https://github.com/Automattic/blocks-engine/tree/trunk/php-transformer",
  "support": {
    "issues": "https://github.com/Automattic/blocks-engine/issues",
    "source": "https://github.com/Automattic/blocks-engine-php-transformer"
  },
  "autoload": {
    "psr-4": {
      "Automattic\\BlocksEngine\\PhpTransformer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Automattic\\BlocksEngine\\PhpTransformer\\Tests\\": "tests/",
      "Automattic\\BlocksEngine\\PhpTransformer\\CorpusDiagnostics\\": "dev/CorpusDiagnostics/",
      "Automattic\\BlocksEngine\\PhpTransformer\\Topology\\": "dev/Topology/",
      "Automattic\\BlocksEngine\\PhpTransformer\\VisualParity\\": "dev/VisualParity/"
    }
  },
  "require": {
    "league/commonmark": "^2.5",
    "league/html-to-markdown": "^5.1",
    "php": ">=8.3",
    "ext-mbstring": "*"
  },
  "scripts": {
    "lint": ["@lint:php", "@lint:types"],
    "lint:php": "phpcs --standard=phpcs.xml.dist",
    "lint:types": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "test:lint": "php tests/contract/library-lint.php",
    "parity": "@test:parity",
    "static-parity": "php tools/static-parity/run.php",
    "live-wp-parity": "php tools/live-wp-parity/run.php",
    "visual:image-custom-host-promotion": "node tools/visual-parity/tests/image-custom-host-promotion.mjs",
    "visual:empty-destination-anchor": "node tools/visual-parity/tests/empty-destination-anchor.mjs",
    "visual:empty-css-sized-paint": "node tools/visual-parity/tests/empty-css-sized-paint.mjs",
    "visual:empty-inline-painted-box": "node tools/visual-parity/tests/empty-inline-painted-box.mjs",
    "visual:conditional-empty-boundary": "node tools/visual-parity/tests/conditional-empty-visual-boundary.mjs",
    "visual:conditional-positioned-fill": "node tools/visual-parity/tests/conditional-positioned-percentage-fill.mjs",
    "visual:inline-flex-svg-label": "node tools/visual-parity/tests/inline-flex-svg-label.mjs",
    "visual:synthetic-inline-image-percentage": "node tools/visual-parity/tests/synthetic-inline-image-percentage.mjs",
    "visual:image-transform-reference-box": "node tools/visual-parity/tests/image-transform-reference-box.mjs",
    "visual:figure-media-frame": "node tools/visual-parity/tests/figure-media-frame.mjs",
    "visual:hidden-lone-button": "node tools/visual-parity/tests/hidden-lone-button.mjs",
    "visual:button-intrinsic-height": "node tools/visual-parity/tests/button-intrinsic-height.mjs",
    "visual:bottom-thumbnail-carousel": "node tools/visual-parity/tests/bottom-thumbnail-carousel.mjs",
    "visual:button-padding-height": "node tools/visual-parity/tests/button-padding-height.mjs",
    "visual:source-class-selector-ownership": "node tools/visual-parity/tests/source-class-selector-ownership.mjs",
    "visual:nested-responsive-font-size": "node tools/visual-parity/tests/nested-responsive-font-size.mjs",
    "test:custom-property-state-paint-browser": "node tests/contract/custom-property-state-paint-browser.mjs",
    "test:detached-auto-inset-backdrop-browser": "node tests/unit/detached-auto-inset-backdrop-browser.mjs",
    "test:social-profile-flex-cluster-browser": "node tests/unit/social-profile-flex-cluster-browser.mjs",
    "test:stretched-button-box-sizing-browser": "node tests/unit/stretched-button-box-sizing-browser.mjs",
    "test:search-input-group-browser": "node tests/unit/search-input-group-browser.mjs",
    "test:sibling-link-lists-browser": "node tests/contract/sibling-link-lists-browser.mjs",
    "test:navigation-icon-reset-browser": "node tests/unit/navigation-icon-reset-browser.mjs",
    "test:social-links-icon-font-browser": "node tests/unit/social-links-icon-font-browser.mjs",
    "test:social-links-glyph-paint-browser": "node tests/unit/social-links-glyph-paint-browser.mjs",
    "test:image-caption-margins-browser": "node tests/unit/image-caption-margins-browser.mjs",
    "test:collection-component-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-collection-component-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/collection-component-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "test:slideshow-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-slideshow-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/slideshow-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "test:structural-carousel-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-structural-carousel-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/structural-carousel-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "test:carousel-control-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-carousel-control-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/carousel-control-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "test:captured-gallery-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-captured-gallery-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/captured-gallery-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "visual:native-emoji-wordpress": "node tools/visual-parity/tests/native-emoji-wordpress.mjs",
    "test:palette-alpha-browser": "BE_EDITOR_ACCEPTANCE_BUILDER=tests/build-palette-alpha-acceptance.php BE_EDITOR_ACCEPTANCE_BROWSER=tests/palette-alpha-acceptance.mjs bash tools/run-editor-image-acceptance.sh",
    "test:design-system-restyle": "bash tests/integration/design-system-restyle.sh",
    "visual:source-wordpress-presets": "node tools/visual-parity/tests/source-wordpress-presets.mjs",
    "benchmark:selector-cache": "php tools/benchmarks/css-selector-match-cache.php",
    "benchmark:staged-page-compilation": "php tools/benchmarks/staged-page-compilation-production.php",
    "corpus-diagnostics": "php tools/corpus-diagnostics/run.php",
    "topology-diff": [
      "Composer\\Config::disableProcessTimeout",
      "php -d memory_limit=3G tools/topology-diff/run.php"
    ],
    "shared-chrome-corpus": "php -d memory_limit=2G tools/shared-chrome-corpus/run.php",
    "content-round-trip": "php tools/content-round-trip/run.php",
    "test": [
      "@test:scripts",
      "@test:parity",
      "@test:packaging"
    ],
    "test:scripts": [
      "Composer\\Config::disableProcessTimeout",
      "php tests/run.php"
    ],
    "test:parity": "php tests/parity/run.php",
    "test:migration:examples": "php tests/migration/examples.php",
    "test:migration:legacy-parity": "BLOCKS_ENGINE_PARITY_LEGACY=1 php tests/parity/run.php --migration-comparison",
    "test:wordpress-integration": [
      "php tests/integration/wordpress-site-plan.php",
      "php tests/integration/theme-bootstrap-shared-data.php",
      "php tests/integration/editor-static-state-sharing.php",
      "php tests/integration/design-system-palette.php",
      "php tests/integration/social-anchor-colors.php",
      "php tests/integration/social-links-source-margins.php",
      "php tests/integration/empty-button-accessible-label.php"
    ],
    "test:packaging": [
      "php tests/packaging/dist-shape.php",
      "php tests/packaging/install-proof.php"
    ]
  },
  "config": {
    "cache-dir": "var/cache/composer",
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^7.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^4.0",
    "yoast/phpunit-polyfills": "^3.0"
  }
}

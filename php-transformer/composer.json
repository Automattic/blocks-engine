{
  "name": "automattic/blocks-engine-php-transformer",
  "description": "PHP primitives for transforming HTML, Markdown, and website artifacts into WordPress block outputs.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Automattic"
    }
  ],
  "keywords": [
    "blocks",
    "html",
    "markdown",
    "wordpress"
  ],
  "homepage": "https://github.com/Automattic/blocks-engine/tree/trunk/php-transformer",
  "support": {
    "issues": "https://github.com/Automattic/blocks-engine/issues",
    "source": "https://github.com/Automattic/blocks-engine-php-transformer"
  },
  "autoload": {
    "psr-4": {
      "Automattic\\BlocksEngine\\PhpTransformer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Automattic\\BlocksEngine\\PhpTransformer\\Tests\\": "tests/",
      "Automattic\\BlocksEngine\\PhpTransformer\\CorpusDiagnostics\\": "dev/CorpusDiagnostics/",
      "Automattic\\BlocksEngine\\PhpTransformer\\Topology\\": "dev/Topology/",
      "Automattic\\BlocksEngine\\PhpTransformer\\VisualParity\\": "dev/VisualParity/"
    }
  },
  "require": {
    "league/commonmark": "^2.5",
    "league/html-to-markdown": "^5.1",
    "php": ">=8.2",
    "ext-mbstring": "*"

    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "serialized_blocks", "assert": "contains", "value": "\"label\":\"By Outing\"" },
    { "path": "serialized_blocks", "assert": "contains", "value": "\"label\":\"Day Hike\"" },

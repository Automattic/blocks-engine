    { "path": "serialized_blocks", "assert": "contains", "value": "<time class=\"session-time\">10:00 AM</time>" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<p class=\"session-title blocks-engine-synthetic-paragraph\">Opening keynote</p>" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<p class=\"detail-label blocks-engine-synthetic-paragraph\">Location</p>" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<p class=\"detail-value blocks-engine-synthetic-paragraph\">Main Hall</p>" },

{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "wordpress-is-dead-hero",
  "description": "Converts a compact WordPress Is Dead hero/actions product fixture slice into supported core blocks.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/wordpress-is-dead/index.html",
    "notes": "Representative hero, rich paragraph, and CTA row only; avoids copying the five-page static site fixture."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "The product smoke covers theme generation, link rewrites, CSS preservation, and navigation entities outside this transformer contract."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<section class=\"hero\"><div class=\"container\"><span class=\"eyebrow\">A Public Service Announcement</span><h1><span class=\"strike\">WordPress</span><br>is officially dead.</h1><p class=\"lede\">Generated from a <em>single sentence</em>. No <code>wp-admin</code>.</p><div class=\"cta-row\"><a class=\"btn primary\" href=\"manifesto.html\" style=\"padding:10px 16px;background:#135e96\">Read the Manifesto</a><a class=\"btn ghost\" href=\"proof.html\" style=\"padding:10px 16px;border:1px solid #135e96\">See The Proof</a></div></div></section>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/group" },
    { "path": "blocks.0.innerBlocks.0", "name": "core/group" },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.0", "name": "core/paragraph", "attrs": { "className": "eyebrow", "content": "A Public Service Announcement" } },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.1", "name": "core/heading", "attrs": { "level": 1 } },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.2", "name": "core/paragraph", "attrs": { "content": "Generated from a <em>single sentence</em>. No <code>wp-admin</code>." } },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.3", "name": "core/buttons" },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.3.innerBlocks.0", "name": "core/button", "attrs": { "text": "Read the Manifesto", "url": "manifesto.html" } },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.3.innerBlocks.1", "name": "core/button", "attrs": { "text": "See The Proof", "url": "proof.html" } }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks", "assert": "count", "count": 1 },
    { "path": "blocks.0.innerBlocks", "assert": "count", "count": 1 },
    { "path": "blocks.0.innerBlocks.0.innerBlocks", "assert": "count", "count": 4 },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.1.attrs.content", "assert": "contains", "value": "WordPress" },
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "coverage.0.fallback_count", "assert": "equals", "value": 0 }
  ]
}

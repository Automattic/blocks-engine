{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "canvas-companion-runtime",
  "description": "Preserves an editable native canvas and bounded fallback text plus unresolved runtime metadata.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/smoke-unsupported-html-fallback-hook.php",
    "notes": "The canvas surface now has a typed block; script behavior remains an unresolved runtime island."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "Fallback hook behavior requires the WordPress plugin runtime."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<canvas id=\"runtime-canvas\"><p>Fallback content</p></canvas>",
    "options": {
      "runtime_canvas_selectors": ["#runtime-canvas"]
    }
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "custom/canvas", "attrs": { "canvasId": "runtime-canvas", "fallbackText": "Fallback content" } }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks", "assert": "count", "count": 1 },
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "source_reports.html.runtime_islands", "assert": "count", "count": 1 },
    { "path": "source_reports.html.runtime_islands.0.kind", "assert": "equals", "value": "canvas" },
    { "path": "source_reports.html.runtime_islands.0.selector", "assert": "equals", "value": "#runtime-canvas" },
    { "path": "source_reports.html.runtime_islands.0.source_snippet", "assert": "contains", "value": "<canvas id=\"runtime-canvas\"" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:custom/canvas" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<canvas" },
    { "path": "diagnostics.0.code", "assert": "equals", "value": "html_to_blocks_core_slice" }
  ]
}

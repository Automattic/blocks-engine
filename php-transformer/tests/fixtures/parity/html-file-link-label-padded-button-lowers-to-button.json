    { "path": "serialized_blocks", "assert": "contains", "value": "style=\"display:inline-block;padding:15px 32px;line-height:1;font-weight:700;text-transform:uppercase;white-space:nowrap;--blocks-engine-richtext-marker:" }
  ]

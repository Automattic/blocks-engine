{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-mobile-first-sidebar-desktop-columns",
  "description": "A mobile-first <aside> that is display:none at the base viewport and display:block from a min-width breakpoint is rendered at the desktop reference viewport, so it still partners with <main> and the wrapper stays core/columns.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-mobile-first-sidebar-desktop-columns.json",
    "notes": "Guards the desktop-viewport reading of the sidebar/content partner test: a static-only reading would see the base display:none and drop the real desktop sidebar."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream primitive fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<div class=\"layout\"><aside class=\"sidebar\"><p>Nav</p></aside><main class=\"content\"><h1>Title</h1><p>Body</p></main></div>",
    "options": {
      "static_css": ".sidebar{display:none}@media (min-width: 1024px){.sidebar{display:block;width:250px}}"
    }
  },
  "expected_blocks": [
    {
      "path": "blocks.0",
      "name": "core/columns",
      "attrs": {
        "className": "layout"
      }
    },
    {
      "path": "blocks.0.innerBlocks.0",
      "name": "core/column"
    },
    {
      "path": "blocks.0.innerBlocks.1",
      "name": "core/column"
    }
  ],
  "expected_fallbacks": [],
  "expect": [
    {
      "path": "status",
      "assert": "equals",
      "value": "success"
    },
    {
      "path": "blocks",
      "assert": "count",
      "count": 1
    },
    {
      "path": "blocks.0.innerBlocks",
      "assert": "count",
      "count": 2
    },
    {
      "path": "serialized_blocks",
      "assert": "contains",
      "value": "<!-- wp:columns {\"className\":\"layout\"} -->"
    },
    {
      "path": "serialized_blocks",
      "assert": "contains",
      "value": "<!-- wp:column {\"className\":\"sidebar"
    }
  ]
}

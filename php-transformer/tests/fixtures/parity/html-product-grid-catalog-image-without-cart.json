{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-product-grid-catalog-image-without-cart",
  "description": "Emits an html_product_grid_fallback for a browse/marketplace catalog grid whose cards carry a name, a one-time price, and a per-card photo but no add-to-cart control and no schema.org markup -- the purchase action lives on a detail page, not the grid card. Requires at least four such image-corroborated cards before trusting the weaker signal. Every product in the grid shares one page-owned binding anchor -- the grid container's own emitted block -- so a downstream consumer can replace the whole grid region with a native product-collection block.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-product-grid-catalog-image-without-cart.json",
    "notes": "Real-world marketplace/browse grids (captured evidence: a logo marketplace catalog page) commonly show name + price + photo per card with the buy action on a separate detail page, so no cart-control token appears on the grid card itself. CommerceStructureRecognizer::productCardData() qualifies this structural quad (name + one-time price + image) without a cart control, and CommerceFallbackReporter requires >= 4 such image-only-qualified cards in one grid before emitting a finding, since a small (2-3 card) count is a far more common false positive (e.g. a pricing/plan comparison) than a real catalog is. Because no card carries a cart control of its own, every product in the grid shares one commerce_collection binding anchored on the grid container's own emitted block, resolved against the page's real block tree the same way blocks-engine#1975 anchors a div pseudo-form -- rather than staying frozen source markup with no bindable anchor at all (blocks-engine#2013, blocks-engine#718/#1975)."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream commerce-recognition fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<main><h1>Shop</h1><div class=\"grid grid-cols-4 gap-5\"><div class=\"card\"><img src=\"/media/ring.jpg\" alt=\"Solaris Ring\"><h3>Solaris Ring</h3><span class=\"price\">$64.99</span></div><div class=\"card\"><img src=\"/media/wave.jpg\" alt=\"Prism Wave\"><h3>Prism Wave</h3><span class=\"price\">$54.99</span></div><div class=\"card\"><img src=\"/media/pulse.jpg\" alt=\"Green Pulse\"><h3>Green Pulse</h3><span class=\"price\">$29.99</span></div><div class=\"card\"><img src=\"/media/apex.jpg\" alt=\"Apex Dynamics\"><h3>Apex Dynamics</h3><span class=\"price\">$49.99</span></div></div></main>"
  },
  "expected_fallbacks": [
    { "type": "html", "reason": "commerce_product_grid_detected", "tag": "div", "diagnostic_code": "html_product_grid_fallback", "kind": "html_product_grid_fallback", "product_count": 4 }
  ],

  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-semantic-container-tagname.json",
    "notes": "Product-neutral coverage for core/group tagName fidelity on semantic HTML5 landmarks."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream primitive fixture has no downstream legacy comparison."

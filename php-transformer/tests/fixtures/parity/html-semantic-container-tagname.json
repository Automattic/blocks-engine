  "operation": "html_transformer.transform",
  "input": {
    "content": "<header class=\"site-header\"><h2>Brand</h2><p>Tagline copy.</p></header>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/group", "attrs": { "className": "site-header", "tagName": "header" } }

{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-standalone-layout-button-keeps-direct-child-topology",
  "description": "Standalone native buttons that are already direct children of an authored flex container keep a valid core/buttons > core/button tree, but the synthesized wrappers are layout-neutral so they do not become extra flex items.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-standalone-layout-button-keeps-direct-child-topology.json",
    "notes": "Regression fixture for a CSS-owned flex filter row whose direct children are bare <button> elements. Gutenberg conversion wrapped each button in core/buttons, so the flex row's children became wp-block-buttons boxes and the row inflated. The wrappers must remain for validity and be flattened with the existing layout-neutral marker."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This is a regression fixture for an upstream primitive with no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<div class=\"row\"><button class=\"chip\" type=\"button\">All</button><button class=\"chip\" type=\"button\">Kitchens</button><button class=\"chip\" type=\"button\">Bathrooms</button><button class=\"chip\" type=\"button\">Whole-Home</button><button class=\"chip\" type=\"button\">Outdoor</button><button class=\"chip\" type=\"button\">Commercial</button></div>",
    "options": {
      "static_css": ".row{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}.chip{padding:8px 20px;font-size:14px;line-height:20px;font-weight:600;letter-spacing:0.35px}"
    }
  },
  "expected_blocks": [
    {
      "path": "blocks.0",
      "name": "core/group"
    },
    {
      "path": "blocks.0.innerBlocks.0",
      "name": "core/buttons"
    },
    {
      "path": "blocks.0.innerBlocks.0.innerBlocks.0",
      "name": "core/button",
      "attrs": {
        "tagName": "button",
        "text": "All",
        "type": "button"
      }
    },
    {
      "path": "blocks.0.innerBlocks.5",
      "name": "core/buttons"
    },
    {
      "path": "blocks.0.innerBlocks.5.innerBlocks.0",
      "name": "core/button",
      "attrs": {
        "tagName": "button",
        "text": "Commercial",
        "type": "button"
      }
    }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks.0.innerBlocks", "assert": "count", "count": 6 },
    { "path": "serialized_blocks", "assert": "contains", "value": "blocks-engine-css-owned-layout" },
    { "path": "serialized_blocks", "assert": "contains", "value": "blocks-engine-layout-neutral-buttons" },
    { "path": "serialized_blocks", "assert": "contains", "value": "blocks-engine-layout-child-button" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<button" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "wp:html" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "wp:freeform" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "wp:missing" },
    { "path": "source_reports.wp_block_validity.status", "assert": "equals", "value": "pass" }
  ]
}

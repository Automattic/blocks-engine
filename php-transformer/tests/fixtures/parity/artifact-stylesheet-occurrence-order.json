{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "artifact-stylesheet-occurrence-order",
  "description": "Preserves entry HTML stylesheet occurrence order across interleaved inline and linked CSS regardless of artifact file order.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/artifact-stylesheet-occurrence-order.json",
    "notes": "Inline styles use deterministic content-addressed paths; occurrence order stays page-local."
  },
  "legacy_comparison": { "skip": true, "reason": "Stylesheet occurrence ordering is an artifact materialization behavior." },
  "operation": "artifact_compiler.compile",
  "input": {
    "artifact": {
      "files": [
        { "path": "assets/theme.css", "kind": "css", "content": ".blue{color:blue}" },
        { "path": "index.html", "kind": "html", "content": "<!doctype html><html><head><style>.red{color:red}</style><link rel=\"stylesheet\" href=\"assets/theme.css\"><style>.green{color:green}</style></head><body><main><p class=\"red blue green\">Copy</p></main></body></html>" }
      ]
    }
  },
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "assets.0.path", "assert": "equals", "value": "inline/254f690be6e0f7a3edef7a1f33d08bbc19cc58d488a692043fd2eec62cb88352.css" },
    { "path": "assets.0.content", "assert": "contains", "value": ".red{color:red}" },
    { "path": "assets.1.path", "assert": "equals", "value": "assets/theme.css" },
    { "path": "assets.1.content", "assert": "contains", "value": ".blue{color:blue}" },
    { "path": "assets.2.path", "assert": "equals", "value": "inline/f46c753c616631022ae759007a68ffba8379e354eade82d8ca1add70b94f1c3c.css" },
    { "path": "assets.2.content", "assert": "contains", "value": ".green{color:green}" },
    { "path": "source_reports.compiled_site.theme.stylesheets.0", "assert": "equals", "value": "inline/254f690be6e0f7a3edef7a1f33d08bbc19cc58d488a692043fd2eec62cb88352.css" },
    { "path": "source_reports.compiled_site.theme.stylesheets.1", "assert": "equals", "value": "assets/theme.css" },
    { "path": "source_reports.compiled_site.theme.stylesheets.2", "assert": "equals", "value": "inline/f46c753c616631022ae759007a68ffba8379e354eade82d8ca1add70b94f1c3c.css" }
  ]
}

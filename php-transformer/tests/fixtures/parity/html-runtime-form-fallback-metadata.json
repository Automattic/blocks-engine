{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-runtime-form-fallback-metadata",
  "description": "Preserves simple contact and newsletter form markup while reporting submission behavior metadata.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-runtime-form-fallback-metadata.json",
    "notes": "Simple non-search forms stay as form markup while action-backed submit behavior stays in fallback metadata."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream primitive fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<main><form id=\"contact-form\" action=\"/contact\" method=\"post\" aria-label=\"Contact form\" novalidate><label>Name <span aria-hidden=\"true\">*</span><input name=\"name\" required autocomplete=\"name\" maxlength=\"80\"></label><label>Email <input name=\"email\" type=\"email\"></label><textarea name=\"message\" aria-label=\"Message\"></textarea><button type=\"submit\">Send</button></form><form action=\"/newsletter\" method=\"post\" class=\"newsletter\"><label>Email <input type=\"email\" name=\"email\" placeholder=\"you@example.com\"></label><button type=\"submit\" value=\"subscribe\">Subscribe</button></form></main>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/group", "attrs": { "tagName": "main" } },
    { "path": "blocks.0.innerBlocks.0", "name": "core/html" },
    { "path": "blocks.0.innerBlocks.1", "name": "core/html" }
  ],
  "expected_fallbacks": [
    { "type": "html", "reason": "form_requires_runtime", "diagnostic_code": "html_form_fallback" },
    { "type": "html", "reason": "form_requires_runtime", "diagnostic_code": "html_form_fallback" }
  ],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks", "assert": "count", "count": 1 },
    { "path": "fallbacks", "assert": "count", "count": 2 },
    { "path": "fallbacks.0.diagnostic_code", "assert": "equals", "value": "html_form_fallback" },
    { "path": "fallbacks.0.runtime_island_type", "assert": "equals", "value": "provider_materializable_form" },
    { "path": "fallbacks.0.repair_bucket", "assert": "equals", "value": "materialize_form_provider" },
    { "path": "fallbacks.0.materialization_target.provider_role", "assert": "equals", "value": "form_provider" },
    { "path": "fallbacks.0.form.id", "assert": "equals", "value": "contact-form" },
    { "path": "fallbacks.0.form.aria_label", "assert": "equals", "value": "Contact form" },
    { "path": "fallbacks.0.form.novalidate", "assert": "equals", "value": true },
    { "path": "fallbacks.0.form.action", "assert": "equals", "value": "/contact" },
    { "path": "fallbacks.0.control_count", "assert": "equals", "value": 4 },
    { "path": "fallbacks.0.controls.0.name", "assert": "equals", "value": "name" },
    { "path": "fallbacks.0.controls.0.order", "assert": "equals", "value": 0 },
    { "path": "fallbacks.0.controls.0.label", "assert": "equals", "value": "Name" },
    { "path": "fallbacks.0.controls.0.autocomplete", "assert": "equals", "value": "name" },
    { "path": "fallbacks.0.controls.0.maxlength", "assert": "equals", "value": "80" },
    { "path": "fallbacks.0.controls.0.required", "assert": "equals", "value": true },
    { "path": "fallbacks.0.controls.2.tag", "assert": "equals", "value": "textarea" },
    { "path": "fallbacks.0.controls.3.text", "assert": "equals", "value": "Send" },
    { "path": "fallbacks.1.diagnostic_code", "assert": "equals", "value": "html_form_fallback" },
    { "path": "fallbacks.1.runtime_island_type", "assert": "equals", "value": "provider_materializable_form" },
    { "path": "fallbacks.1.form.action", "assert": "equals", "value": "/newsletter" },
    { "path": "fallbacks.1.control_count", "assert": "equals", "value": 2 },
    { "path": "serialized_blocks", "assert": "contains", "value": "<form id=\"contact-form\" action=\"/contact\" method=\"post\" aria-label=\"Contact form\" novalidate>" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<textarea name=\"message\" aria-label=\"Message\"></textarea>" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<form action=\"/newsletter\" method=\"post\" class=\"newsletter\">" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<button type=\"submit\" value=\"subscribe\">Subscribe</button>" },
    { "path": "diagnostics.1.runtime_island_type", "assert": "equals", "value": "provider_materializable_form" },
    { "path": "diagnostics.1.controls", "assert": "count", "count": 4 },
    { "path": "diagnostics.1.materialization_target.provider_role", "assert": "equals", "value": "form_provider" },
    { "path": "diagnostics.3.runtime_island_type", "assert": "equals", "value": "provider_materializable_form" },
    { "path": "diagnostics.3.form.id", "assert": "equals", "value": "contact-form" },
    { "path": "coverage.0.block_count", "assert": "equals", "value": 1 },
    { "path": "coverage.0.fallback_count", "assert": "equals", "value": 2 }
  ]
}

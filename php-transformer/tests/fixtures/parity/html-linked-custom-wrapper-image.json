{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-linked-custom-wrapper-image",
  "description": "A plain linked custom image wrapper promotes to core/image with its native link destination.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-linked-custom-wrapper-image.json",
    "notes": "Regression coverage for a captured custom media wrapper; no original-site fixture is present in this repository."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "Upstream primitive image behavior; no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<html><body><a href=\"/item\"><img src=\"assets/item.jpg\" width=\"640\" height=\"480\" alt=\"Item 1\"></a></body></html>",
    "options": {
      "context": {
        "asset_metadata": {
          "assets/item.jpg": {
            "id": 42,
            "url": "https://example.test/wp-content/uploads/profile.jpg"
          }
        }
      }
    }
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/image" }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks", "assert": "count", "count": 1 },
    { "path": "blocks.0.attrs.href", "assert": "equals", "value": "/item" },
    { "path": "blocks.0.attrs.linkDestination", "assert": "equals", "value": "custom" },
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "coverage.0.fallback_count", "assert": "equals", "value": 0 }
  ]
}

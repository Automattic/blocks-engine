{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-section-runtime-island-classification",
  "description": "A genuine canvas/script section keeps its runtime canvas as a bounded island while surrounding content remains native and editable.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-section-runtime-island-classification.json",
    "notes": "Distilled from runtime-heavy canvas sections: native blocks cannot preserve the canvas runtime contract, so the assertion is classification, not conversion."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream artifact primitive has no downstream legacy comparison."
  },
  "operation": "artifact_compiler.compile",
  "input": {
    "artifact": {
      "schema": "blocks-engine/php-transformer/site-artifact/v1",
      "entry_path": "index.html",
      "files": [
        {
          "path": "index.html",
          "kind": "html",
          "mime_type": "text/html",
          "role": "document",
          "content": "<main><section id=\"stage\" class=\"stage\"><canvas id=\"stage-canvas\"></canvas><div id=\"hud\">Ready</div></section><script>const c=document.getElementById('stage-canvas');c.getContext('2d');document.getElementById('hud').textContent='Running';</script></main>"
        }
      ]
    }
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/group" },
    { "path": "blocks.0.innerBlocks.0", "name": "core/html" },
    { "path": "blocks.0.innerBlocks.1", "name": "core/paragraph" }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "source_reports.runtime_islands.0.kind", "assert": "equals", "value": "canvas" },
    { "path": "source_reports.runtime_islands.0.selector", "assert": "equals", "value": "#stage-canvas" },
    { "path": "source_reports.runtime_islands.0.preservation_reason", "assert": "equals", "value": "canvas_requires_runtime" },
    { "path": "source_reports.runtime_islands.0.runtime_requirement", "assert": "equals", "value": "canvas_element_and_client_script_execution" },
    { "path": "source_reports.runtime_islands.1.kind", "assert": "equals", "value": "script" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:group {\"anchor\":\"stage\"" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:html --><canvas id=\"stage-canvas\"" }
  ]
}

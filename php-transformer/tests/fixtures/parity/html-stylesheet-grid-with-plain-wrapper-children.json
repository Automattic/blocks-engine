    { "path": "blocks.0.innerBlocks.0.innerBlocks.2", "name": "core/group" },
    { "path": "blocks.0.innerBlocks.0.innerBlocks.0.innerBlocks.1", "name": "core/heading", "attrs": { "level": 4 } }

    { "path": "serialized_blocks", "assert": "not_contains", "value": "<!-- wp:button" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "<!-- wp:html" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "<!-- wp:list {\"className\":\"nav-links\"}" },

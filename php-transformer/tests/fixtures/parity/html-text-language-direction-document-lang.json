{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-text-language-direction-document-lang",
  "description": "A text element whose lang equals the <html lang> it inherits (case-insensitively) gets no <span lang> wrapper; a different tag (en-GB under en, en under an intermediate fr container) and dir still apply.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-text-language-direction-document-lang.json",
    "notes": "Companion to html-text-language-direction for a full document with a root language."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream primitive fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Languages</title></head><body><p lang=\"en\">English sentence.</p><p lang=\"EN\">Uppercase tag.</p><p lang=\"en-GB\">Colour.</p><p lang=\"ar\" dir=\"rtl\">هذه جملة عربية، مع علامة ترقيم.</p><div lang=\"fr\"><p lang=\"en\">English inside French.</p></div></body></html>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/paragraph", "attrs": { "content": "English sentence." } },
    { "path": "blocks.1", "name": "core/paragraph", "attrs": { "content": "Uppercase tag." } },
    { "path": "blocks.2", "name": "core/paragraph", "attrs": { "content": "<span lang=\"en-GB\">Colour.</span>" } },
    { "path": "blocks.3", "name": "core/paragraph", "attrs": { "direction": "rtl", "content": "<span lang=\"ar\">هذه جملة عربية، مع علامة ترقيم.</span>" } },
    { "path": "blocks.4", "name": "core/paragraph", "attrs": { "content": "<span lang=\"en\">English inside French.</span>" } }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:paragraph --><p>English sentence.</p><!-- /wp:paragraph -->" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "<span lang=\"en\">English sentence." },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "wp:html" },
    { "path": "source_reports.wp_block_validity.status", "assert": "equals", "value": "pass" }
  ]
}

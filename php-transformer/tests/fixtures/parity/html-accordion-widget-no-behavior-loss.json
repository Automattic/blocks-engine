  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/accordion", "attrs": { "className": "accordion" } },
    { "path": "blocks.0.innerBlocks.0", "name": "core/accordion-item", "attrs": { "className": "item" } },

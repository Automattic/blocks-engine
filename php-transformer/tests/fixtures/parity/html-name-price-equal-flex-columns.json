{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-name-price-equal-flex-columns",
  "description": "Name/price and label/value rows with explicit equal zero-basis flex items remain editable author-layout islands controlled by source CSS.",
  "legacy_comparison": { "skip": true, "reason": "Companion-block coverage for faithful author-owned flex topology." },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<style>.menu-row,.detail-pair{display:flex}.item-name,.item-price,.detail-label,.detail-value{flex:1 1 0}</style><div class=\"menu-row\"><p class=\"item-name\">Roasted Carrots</p><p class=\"item-price\">$14</p></div><div class=\"detail-pair\"><p class=\"detail-label\">Location</p><p class=\"detail-value\">Main Hall</p></div>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "blocks-engine/author-layout", "attrs": { "className": "menu-row", "tagName": "div" } },
    { "path": "blocks.0.innerBlocks.0", "name": "core/paragraph", "attrs": { "className": "item-name" } },
    { "path": "blocks.0.innerBlocks.1", "name": "core/paragraph", "attrs": { "className": "item-price" } },
    { "path": "blocks.1", "name": "blocks-engine/author-layout", "attrs": { "className": "detail-pair", "tagName": "div" } },
    { "path": "blocks.1.innerBlocks.0", "name": "core/paragraph", "attrs": { "className": "detail-label" } },
    { "path": "blocks.1.innerBlocks.1", "name": "core/paragraph", "attrs": { "className": "detail-value" } }
  ],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:blocks-engine/author-layout {\"className\":\"menu-row\",\"contentMode\":\"inner-blocks\",\"tagName\":\"div\"} -->" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<div class=\"wp-block-blocks-engine-author-layout detail-pair\">" },
    { "path": "source_reports.generated_blocks.0.block_json.name", "assert": "equals", "value": "blocks-engine/author-layout" },
    { "path": "source_reports.generated_blocks.0.block_json.supports.layout", "assert": "equals", "value": false },
    { "path": "blocks", "assert": "count", "count": 2 },
    { "path": "blocks.0.innerBlocks", "assert": "count", "count": 2 },
    { "path": "blocks.1.innerBlocks", "assert": "count", "count": 2 }
  ]
}

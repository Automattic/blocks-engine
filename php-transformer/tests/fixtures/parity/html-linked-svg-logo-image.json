{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-linked-svg-logo-image",
  "description": "A brand/logo anchor wrapping passive SVG artwork and text preserves its authored anchor topology while materializing the SVG and retaining inline geometry and text color parity.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-linked-svg-logo-image.json",
    "notes": "Generic coverage for linked brand/logo anchors with inline SVG marks; the SVG should not force the whole anchor into core/html."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream primitive fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<a class=\"brand-logo\" href=\"/\" aria-label=\"Acme home\" style=\"display:flex;align-items:center;gap:12px;color:#faf4e8;text-decoration:none\"><span class=\"brand-mark\" aria-hidden=\"true\" style=\"flex-shrink:0\"><svg width=\"38\" height=\"38\" viewBox=\"0 0 38 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 28 Q7.5 23 12 28 Q16.5 33 21 28 Q25.5 23 30 28 Q33 31 36 28\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" fill=\"none\"/></svg></span><span><span class=\"brand-name\">Acme Studio</span><span class=\"brand-sub\" style=\"display:block;font-size:10px;letter-spacing:.2em;text-transform:uppercase\">Est. 2018</span></span></a>"
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "blocks-engine/author-layout", "attrs": { "className": "brand-logo", "contentMode": "rich-text", "tagName": "a", "url": "/" } }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "blocks.0.blockName", "assert": "equals", "value": "blocks-engine/author-layout" },
    { "path": "blocks.0.attrs.content", "assert": "contains", "value": "assets/materialized-svg/" },
    { "path": "blocks.0.attrs.url", "assert": "equals", "value": "/" },
    { "path": "assets.0.content", "assert": "contains", "value": "stroke=\"#faf4e8\"" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<!-- wp:blocks-engine/author-layout" },
    { "path": "serialized_blocks", "assert": "contains", "value": "<span class=\"brand-mark\"" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "line-height:0" },
    { "path": "serialized_blocks", "assert": "contains", "value": "class=\"wp-block-blocks-engine-author-layout brand-logo\"" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "<!-- wp:html" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "<svg" },
    { "path": "fallbacks", "assert": "count", "count": 0 }
  ]
}

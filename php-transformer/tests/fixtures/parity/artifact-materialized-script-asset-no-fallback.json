{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "artifact-materialized-script-asset-no-fallback",
  "description": "Treats bundled external and executable inline script tags as materialized theme script assets without raw HTML fallbacks.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/artifact-materialized-script-asset-no-fallback.json",
    "notes": "Covers raw static-site artifacts that include same-site JavaScript files referenced from entry HTML."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream script asset materialization fixture has no downstream legacy comparison."
  },
  "operation": "artifact_compiler.compile",
  "input": {
    "artifact": {
      "entrypoint": "index.html",
      "files": [
        {
          "path": "index.html",
          "kind": "html",
          "content": "<!doctype html><html><head><title>Script Asset</title></head><body><main><h1>Script Asset</h1><p>Content remains block-convertible.</p></main><script src=\"assets/site.js\" defer></script><script>window.inlineRuntime = true;</script></body></html>"
        },
        {
          "path": "assets/site.js",
          "kind": "js",
          "content": "document.documentElement.classList.add('ready');"
        }
      ]
    }
  },
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "fallbacks", "assert": "count", "count": 0 },
    { "path": "serialized_blocks", "assert": "contains", "value": "Content remains block-convertible." },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "assets/site.js" },
    { "path": "serialized_blocks", "assert": "not_contains", "value": "window.inlineRuntime" },
    { "path": "source_reports.compiled_site.theme.scripts.0", "assert": "equals", "value": "index.inline-2.js" },
    { "path": "source_reports.compiled_site.theme.scripts.1", "assert": "equals", "value": "assets/site.js" },
    { "path": "source_reports.materialization_plan.theme.scripts.0", "assert": "equals", "value": "index.inline-2.js" },
    { "path": "source_reports.materialization_plan.theme.scripts.1", "assert": "equals", "value": "assets/site.js" },
    { "path": "source_reports.materialization_plan.assets.0.source", "assert": "equals", "value": "inline-script" },
    { "path": "source_reports.materialization_plan.assets.0.selector", "assert": "equals", "value": "script:nth-of-type(2)" },
    { "path": "source_reports.materialization_plan.assets.0.content", "assert": "equals", "value": "window.inlineRuntime = true;" }
  ]
}

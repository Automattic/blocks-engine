{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "artifact-responsive-image-assets",
  "description": "Lowers a nested plain srcset family to native core/image, keeps its authored selection in block metadata, and resolves every candidate with the existing asset plan.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/artifact-responsive-image-assets.json",
    "notes": "Covers generic nested relative image path resolution, source srcset analysis, and render-time restoration of the authored responsive image selection."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream artifact image asset contract has no downstream legacy comparison."
  },
  "operation": "artifact_compiler.compile",
  "input": {
    "artifact": {
      "entrypoint": "pages/products/detail.html",
      "files": [
        {
          "path": "pages/products/detail.html",
          "content": "<main><figure class=\"product-card\"><img src=\"../../assets/images/hero.png\" srcset=\"../../assets/images/hero-small.png 480w, ../../missing/ghost.png 960w, https://cdn.example.test/hero.png 1200w\" sizes=\"(max-width: 600px) 100vw, 600px\" alt=\"Hero\" width=\"600\" height=\"400\"><figcaption>Hero image</figcaption></figure></main>",
          "mime_type": "text/html",
          "role": "entry"
        },
        {
          "path": "assets/images/hero.png",
          "content_base64": "iVBORw0KGgo=",
          "mime_type": "image/png"
        },
        {
          "path": "assets/images/hero-small.png",
          "content_base64": "iVBORw0KGgo=",
          "mime_type": "image/png"
        }
      ]
    }
  },
  "expected_blocks": [
    { "path": "blocks.0", "name": "core/image" }
  ],
  "expected_fallbacks": [],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "source_reports.artifact.asset_references", "assert": "count", "count": 2 },
    { "path": "source_reports.artifact.image_references", "assert": "count", "count": 2 },
    { "path": "source_reports.artifact.image_references.0.resolved_path", "assert": "equals", "value": "assets/images/hero.png" },
    { "path": "source_reports.artifact.image_references.1.attribute", "assert": "equals", "value": "srcset" },
    { "path": "source_reports.artifact.image_references.1.resolved_path", "assert": "equals", "value": "assets/images/hero-small.png" },
    { "path": "source_reports.wordpress_site_plan.assets", "assert": "count", "count": 3 },
    { "path": "source_reports.materialization_plan.assets.0.path", "assert": "equals", "value": "assets/images/hero.png" },
    { "path": "source_reports.materialization_plan.assets.1.path", "assert": "equals", "value": "assets/images/hero-small.png" },
    { "path": "blocks.0.attrs.url", "assert": "equals", "value": "assets/images/hero.png" },
    { "path": "blocks.0.attrs.metadata.blocksEngineImageSelection.src", "assert": "equals", "value": "assets/images/hero.png" },
    { "path": "blocks.0.attrs.metadata.blocksEngineImageSelection.srcset", "assert": "equals", "value": "assets/images/hero-small.png 480w, ../../missing/ghost.png 960w, https://cdn.example.test/hero.png 1200w" },
    { "path": "blocks.0.attrs.metadata.blocksEngineImageSelection.sizes", "assert": "equals", "value": "(max-width: 600px) 100vw, 600px" },
    { "path": "source_reports.wordpress_site_plan.assets.2.source_role", "assert": "equals", "value": "missing_media_placeholder" },
    { "path": "source_reports.wordpress_site_plan.pages.0.canonical_block_markup", "assert": "not_contains", "value": "../../missing/ghost.png" },
    { "path": "source_reports.wordpress_site_plan.pages.0.canonical_block_markup", "assert": "contains", "value": "https://cdn.example.test/hero.png 1200w" },
    { "path": "source_reports.wordpress_site_plan.pages.0.canonical_block_markup", "assert": "contains", "value": "\"sizes\":\"(max-width: 600px) 100vw, 600px\"" },
    { "path": "source_reports.wordpress_site_plan.pages.0.canonical_block_markup", "assert": "contains", "value": "\"srcset\":\"{{wordpress-site-plan:asset:" },
    { "path": "metrics.block_count", "assert": "equals", "value": 1 }
  ]
}

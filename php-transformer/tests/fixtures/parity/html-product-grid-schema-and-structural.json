{
  "schema": "blocks-engine/php-transformer/parity-fixture/v1",
  "name": "html-product-grid-schema-and-structural",
  "description": "Emits additive product-grid and commerce-control findings for a schema.org Product grid (name/price/sale_price/image/cart control) while leaving a generic services grid and a price-only pricing table unflagged.",
  "source_reference": {
    "repo": "php-transformer",
    "path": "tests/fixtures/parity/html-product-grid-schema-and-structural.json",
    "notes": "Product-neutral fixture: detection is driven by schema.org microdata and the structural commerce triad (name + currency price + add-to-cart control), never by fixture names. Commerce controls are reported as a runtime requirement instead of pretending a native core block can provide cart state. Proves genericity by leaving the services/pricing grids silent."
  },
  "legacy_comparison": {
    "skip": true,
    "reason": "This upstream commerce-recognition fixture has no downstream legacy comparison."
  },
  "operation": "html_transformer.transform",
  "input": {
    "content": "<main><ul class=\"product-grid\"><li class=\"card\" itemscope itemtype=\"https://schema.org/Product\"><img src=\"/img/lamp.jpg\" alt=\"Desk Lamp\"><h3 itemprop=\"name\">Desk Lamp</h3><p class=\"desc\">Warm focused light for any desk.</p><span class=\"price\" itemprop=\"price\">$48</span><span class=\"price sale\">$36</span><a class=\"add-to-cart\" href=\"/cart/add/lamp\">Add to cart</a></li><li class=\"card\" itemscope itemtype=\"https://schema.org/Product\"><h3 itemprop=\"name\">Wall Clock</h3><span class=\"price\" itemprop=\"price\">$29</span><button class=\"buy-now\">Buy now</button></li></ul><div class=\"services grid\"><div class=\"service card\"><h3>Consulting</h3><p>We help you grow.</p><a href=\"/contact\">Learn more</a></div><div class=\"service card\"><h3>Design</h3><p>Beautiful interfaces.</p><a href=\"/contact\">Learn more</a></div></div><section class=\"pricing grid\"><div class=\"tier card\"><h3>Basic</h3><span class=\"price\">$9/mo</span><a href=\"/signup\">Get started</a></div><div class=\"tier card\"><h3>Pro</h3><span class=\"price\">$29/mo</span><a href=\"/signup\">Get started</a></div></section></main>"
  },
  "expected_fallbacks": [
    { "type": "html", "reason": "block_grammar", "tag": "ul", "diagnostic_code": "html_list_item_block_grammar_fallback" },
    { "type": "html", "reason": "commerce_product_grid_detected", "tag": "ul", "diagnostic_code": "html_product_grid_fallback", "kind": "html_product_grid_fallback", "product_count": 2 },
    { "type": "html", "reason": "commerce_controls_require_runtime", "tag": "ul", "diagnostic_code": "html_commerce_controls_fallback", "kind": "html_commerce_controls_fallback", "control_count": 2 }
  ],
  "expect": [
    { "path": "status", "assert": "equals", "value": "success" },
    { "path": "fallbacks", "assert": "count", "count": 3 },
    { "path": "fallbacks.0.diagnostic_code", "assert": "equals", "value": "html_list_item_block_grammar_fallback" },
    { "path": "fallbacks.0.reason", "assert": "equals", "value": "block_grammar" },
    { "path": "fallbacks.0.pattern_family", "assert": "equals", "value": "structural_list" },
    { "path": "fallbacks.0.repair_bucket", "assert": "equals", "value": "map_structural_list_component" },
    { "path": "fallbacks.1.diagnostic_code", "assert": "equals", "value": "html_product_grid_fallback" },
    { "path": "fallbacks.1.kind", "assert": "equals", "value": "html_product_grid_fallback" },
    { "path": "fallbacks.1.reason_code", "assert": "equals", "value": "html_product_grid_fallback" },
    { "path": "fallbacks.1.pattern_family", "assert": "equals", "value": "commerce_product_grid" },
    { "path": "fallbacks.1.runtime_island_type", "assert": "equals", "value": "provider_materializable_products" },
    { "path": "fallbacks.1.repair_bucket", "assert": "equals", "value": "materialize_commerce_products" },
    { "path": "fallbacks.1.container_selector", "assert": "equals", "value": "main:nth-of-type(1) > ul:nth-of-type(1)" },
    { "path": "fallbacks.1.products", "assert": "count", "count": 2 },
    { "path": "fallbacks.1.products.0.name", "assert": "equals", "value": "Desk Lamp" },
    { "path": "fallbacks.1.products.0.price", "assert": "equals", "value": "$48" },
    { "path": "fallbacks.1.products.0.sale_price", "assert": "equals", "value": "$36" },
    { "path": "fallbacks.1.products.0.description", "assert": "equals", "value": "Warm focused light for any desk." },
    { "path": "fallbacks.1.products.0.image.src", "assert": "equals", "value": "/img/lamp.jpg" },
    { "path": "fallbacks.1.products.0.image.alt", "assert": "equals", "value": "Desk Lamp" },
    { "path": "fallbacks.1.products.0.has_cart_control", "assert": "equals", "value": true },
    { "path": "fallbacks.1.products.0.source_selector", "assert": "equals", "value": "main:nth-of-type(1) > ul:nth-of-type(1) > li:nth-of-type(1)" },
    { "path": "fallbacks.1.products.1.name", "assert": "equals", "value": "Wall Clock" },
    { "path": "fallbacks.1.products.1.price", "assert": "equals", "value": "$29" },
    { "path": "fallbacks.1.products.1.sale_price", "assert": "equals", "value": null },
    { "path": "fallbacks.1.products.1.has_cart_control", "assert": "equals", "value": true },
    { "path": "fallbacks.2.diagnostic_code", "assert": "equals", "value": "html_commerce_controls_fallback" },
    { "path": "fallbacks.2.kind", "assert": "equals", "value": "html_commerce_controls_fallback" },
    { "path": "fallbacks.2.pattern_family", "assert": "equals", "value": "commerce_controls" },
    { "path": "fallbacks.2.runtime_island_type", "assert": "equals", "value": "commerce_cart_controls" },
    { "path": "fallbacks.2.repair_bucket", "assert": "equals", "value": "materialize_commerce_runtime" },
    { "path": "fallbacks.2.runtime_requirement", "assert": "equals", "value": "commerce_cart_runtime" },
    { "path": "fallbacks.2.controls", "assert": "count", "count": 2 },
    { "path": "fallbacks.2.controls.0.product_name", "assert": "equals", "value": "Desk Lamp" },
    { "path": "fallbacks.2.controls.1.product_name", "assert": "equals", "value": "Wall Clock" },
    { "path": "diagnostics.2.runtime_island_type", "assert": "equals", "value": "provider_materializable_products" },
    { "path": "diagnostics.2.materialization_target.provider_role", "assert": "equals", "value": "commerce_product_provider" },
    { "path": "diagnostics.2.products", "assert": "count", "count": 2 },
    { "path": "diagnostics.3.runtime_island_type", "assert": "equals", "value": "commerce_cart_controls" },
    { "path": "diagnostics.3.controls.0.has_cart_control", "assert": "equals", "value": true },
    { "path": "diagnostics.3.materialization_target.provider_role", "assert": "equals", "value": "commerce_cart_runtime" }
  ]
}
